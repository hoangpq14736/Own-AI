# ================================================================
# Configuration for Self-Learning Multimodal AI Assistant
# ================================================================

# 1. Google Gemini API Key (Get free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Telegram Bot Token (Get free from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 3. Model Configuration (Can be changed anytime without breaking memories!)
# Recommended options:
# - gemini-2.5-flash (fastest, multimodal, cost-effective)
# - gemini-2.5-pro   (deepest reasoning)
MODEL_NAME=gemini-2.5-flash

# 4. Optional Security: Comma-separated Telegram User IDs allowed to use the bot
# Leave empty to allow all users, or put your ID (e.g. 123456789)
# You can find your ID by messaging @userinfobot on Telegram
ALLOWED_USER_IDS=

# 5. Storage Directory
DATA_DIR=./data

# 6. Automated Reports, Backups & Control Room Configuration
ENABLE_DAILY_REPORT=true
DAILY_REPORT_HOUR=8
ENABLE_AUTO_BACKUP=true
# Set to your Control Room group ID (e.g. -100...) so the bot chats freely with you without needing @bot tags
ADMIN_CHAT_ID=
# Optional: Set to true if you want the bot to chat freely in ALL groups without needing @bot tags
ENABLE_GROUP_FREE_CHAT=false

# 7. Repository Auto-Update Configuration
# Automatically pulls changes from GitHub when the bot starts or restarts
AUTO_UPDATE_ON_RESTART=true
GIT_BRANCH=main
GIT_REPO_URL=https://github.com/hoangpq14736/Own-AI.git
# Optional: If your GitHub repo is Private, provide a Personal Access Token (PAT) from https://github.com/settings/tokens
# Alternatively, simply set your repository visibility to Public on GitHub
GITHUB_TOKEN=

# 8. Userbot Hands-Free Dispatcher (Sends /leech & /mirror as YOUR personal account to activate MLTB)
# Get API_ID and API_HASH from https://my.telegram.org (under API Development tools)
# Generate TELEGRAM_USER_SESSION by running: python scripts/generate_session.py
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_SESSION=

# 9. Uncensored Personal AI / Safety Filter Configuration
# Set to true to disable aggressive API-level safety censorship (BLOCK_NONE)
# and enable unrestricted, authentic personal companion conversations.
DISABLE_SAFETY_FILTERS=true

